DATABASE_URL="postgresql://smeconnect:smeconnect@localhost:5432/smeconnect?schema=public"

# Connections per server instance (default 10). Use the provider's pooled
# connection string (Neon: the "-pooler" host) so many instances can share it.
DATABASE_POOL_MAX="10"

# Worker threads for password hashing (Node's default is 4). 16 cut sign-up time
# under load from ~2.9 s to ~1.2 s in the bot test.
UV_THREADPOOL_SIZE="16"

# Optional: direct (non-pooled) connection used only by Prisma CLI commands
# (migrate deploy, seed). Leave empty locally; on Neon use the host without "-pooler".
DIRECT_URL=""

# Host port for the Docker Postgres container. Change if 5432 is already taken
# (then update the port in DATABASE_URL to match).
POSTGRES_PORT="5432"

# Generate with `openssl rand -base64 32` (minimum 32 characters).
BETTER_AUTH_SECRET="replace-with-a-secure-secret"
BETTER_AUTH_URL="http://localhost:4000"

# Optional: extra origins Better Auth should trust, as comma-separated full URLs.
# BETTER_AUTH_URL is always trusted. Set this to the frontend's URL.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

APP_URL="http://localhost:3000"

# Optional: leave empty to use the default (enabled locally, disabled in production).
# Set explicitly to "true" to expose docs in production, or "false" to force them off.
API_DOCS_ENABLED=""

# Optional: extra hostname(s) allowed to load the Next.js dev server over the network.
# Local private IPv4 addresses and localhost are detected automatically.
# Comma-separated hostnames only (no scheme or port), e.g. "192.168.0.109,my-tunnel.example.com".
NEXT_ALLOWED_DEV_ORIGINS=""

SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# Sender address used by the email delivery layer.
EMAIL_FROM="SME Connect <no-reply@localhost>"

# Local phone OTP delivery: "email" (Mailpit) or "console" (metadata only, never the OTP).
OTP_DELIVERY_PROVIDER="email"

# Where rate-limit counters live: "memory" (single process, local dev) or
# "database" (shared by every instance; required on Vercel/serverless).
RATE_LIMIT_STORE="memory"
MESSAGE_RATE_LIMIT_MAX="30"
MESSAGE_RATE_LIMIT_WINDOW_SECONDS="60"

# Where uploads go: "local" (UPLOAD_DIR on disk, dev only) or "database"
# (Postgres bytea; works on read-only serverless filesystems). Files are capped
# at 5 MB and checked by magic bytes, not just the declared type.
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# First administrator, created by `pnpm db:seed` (the only thing the seed does).
# ADMIN_PASSWORD needs 12+ characters and is only read when the account is created.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="SME Connect Admin"

# Google sign-in (optional). Create an OAuth client in Google Cloud Console and
# add the redirect URI <APP_URL>/api/v1/auth/callback/google. While empty, the
# Google button explains that Google sign-in isn't set up. See docs/GOOGLE_AUTH.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
