# Copy to .env.local (git-ignored). All optional for local development.

# Where the backend API runs. The browser calls /api/v1/* on this app and Next.js
# forwards it here, so cookies stay first-party. In production: the backend's
# Vercel URL, e.g. https://smeconnect-api.vercel.app
BACKEND_URL="http://localhost:4000"

# Show "Try a demo account" on the login page in production too (it always shows
# in development). Only for a showcase running on seeded demo data.
SHOW_DEMO_LOGIN="false"

# Password those demo buttons use. Must match the backend's SEED_DEMO_PASSWORD.
SEED_DEMO_PASSWORD="Password123!"
