{
  "name": "smeconnect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "npm --prefix mock-api run dev",
    "build": "next build",
    "start": "next start",
    "start:api": "npm --prefix mock-api start",
    "typecheck": "tsc --noEmit && npm --prefix mock-api run typecheck",
    "seed": "npm --prefix mock-api run seed",
    "postinstall": "npm --prefix mock-api install",
    "fetch:images": "node scripts/download-images.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
