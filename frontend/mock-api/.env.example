# Copy to frontend/mock-api/.env (git-ignored) or set these in your shell. All are optional.

# Port the API listens on. The Next.js app forwards /api/* here (see API_URL below).
PORT=4000

# SQLite file, relative to frontend/mock-api/. Created and seeded with demo data on first start.
DB_PATH=data/smeconnect.db

# How long a login lasts.
SESSION_TTL_DAYS=7

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=10

# Password given to every seeded demo account (development data only).
SEED_PASSWORD=Demo@12345

# For the Next.js app (root .env.local), if the API runs somewhere else:
# API_URL=http://localhost:4000
