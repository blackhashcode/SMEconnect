# One ignore file for the whole repository. Per-package files (backend/.gitignore)
# only add rules specific to that package.

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ── Build output and caches ─────────────────────────────────────────────────
.next/
out/
build/
dist/
coverage/
.turbo/
.vercel/
*.tsbuildinfo
# Regenerated by Next.js on every dev/build run.
next-env.d.ts

# ── Environment variables and secrets (never commit) ────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
service-account*.json
*secret*.json
*secrets*.json
opencode.json

# ── Local data ──────────────────────────────────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS and editor files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ── Local AI-assistant notes and prompts (stay on your machine) ─────────────
.claude/
CLAUDE.md
AGENTS.md
BACKEND_PROMPT.md
backend/docs/implementation/

# ── Source photos before compression (optimised copies live in frontend/public/images) ──
/Photos/
